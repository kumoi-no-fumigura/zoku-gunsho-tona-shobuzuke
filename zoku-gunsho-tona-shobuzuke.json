  },
  {
   "seq": "10",
   "text": "深山路やまさ木のかつら春かけてくる人なしにみゆき降つゝ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "五",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "11",
   "text": "青柳のみとりのいとにぬきとめて玉をたれたる春の白露",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "12",
   "text": "見わたせはよはき柳の枝にのみ声なき風の着こな夕くれ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "六",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "13",
   "text": "あけくれは袖のみぬれてはるさめの世にけるよひもなき我身かな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "14",
   "text": "春雨はしつかにふりて山里の軒はのまきのしつくそふなり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "七",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "15",
   "text": "山かつとなりにし身には印も香もいつしりかほに花を見るらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "16",
   "text": "桜より山路にくらすはるの日のなかきにあかぬ老のまつかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "八",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "17",
   "text": "おく山のみねのあらしに散花をさそひていつる谷川の水",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "18",
   "text": "ちりはつるあらしのあとの枝になを猶のこすさゝかにの原",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "九",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "19",
   "text": "花に見しそのおもかけるしなこりなくこすゑゑけりて春そ暮ぬる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "20",
   "text": "暮すにこれやかきりとおもひこし入相のかねに春もいまめり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "21",
   "text": "ほとゝきすいかにしのふる比なれはかふけてもおしむ初音なるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "22",
   "text": "きゝぬとは人にもつけしほとゝきす忍ふるこゑを我にかたらへ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十一",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "23",
   "text": "月うときもりの木かけも白妙にむら〳〵さける卯花の色",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "24",
   "text": "名もしるじ紅花かきの白妙にむすふや露の玉川のさと",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十二",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "25",
   "text": "うらやましあつむるまとのほたるたにをのかひかりそ身を照しける",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "26",
   "text": "秋ちかき野沢のほたるいかなれはもえてもかけのすしかるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "27",
   "text": "なつかりのなにはのあしの見しか夜に月もいり元のなみそあけ行",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "28",
   "text": "はれそむる雲のたえまにかけみえて月めつらしき五月雨の空",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十四",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "29",
   "text": "たなはたのちきる一夜を待わひて積る涙やあまの川なみ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "30",
   "text": "七夕のあまのはころもかさねてやかはらぬ秋を又ちきるらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "31",
   "text": "をのつからかせふかぬまはくさの葉にあまりておつなのへの白露",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "32",
   "text": "みやき野や野このあとのしら露におきもかへらぬ秋はきの老",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "十九",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "33",
   "text": "むさし野のおなし草葉にふしなれてかへるやまなきさをしかの夢の",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "二十",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "34",
   "text": "おもひきやいりぬる山の鹿の音になをうきことをきかん物とは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "二十",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "35",
   "text": "きよみかたとをきなみちの末はれておきつゑほあひに月すかるふく",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "36",
   "text": "舟よするいり江の芦まかきわけて跡にさはらぬ月をみるかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿一",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "37",
   "text": "山の端にのこるはそれとみえなから光そそわぬ有田の月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿二",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "38",
   "text": "晴やらぬとやまのそらの朝きりにのこるもうすき月のかけかな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿二",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "39",
   "text": "真柴たくふもとの給ふりたちそひてなを夜をこむる峯の朝きり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "40",
   "text": "吹おろすめ中の裾野のあき風にのこれるきりやうき嶋か原",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿三",
   "side": "",
   "dai": "持"
  },
  {
   "seq": "41",
   "text": "一長目やしくるゝそらに属なきて秋すさましき雲の色かな",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿四",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "42",
   "text": "あらしゆくひらのみなとの夕霧に山もとみえてかへるつりふね",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿四",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "43",
   "text": "今よりの夜寒そたへぬさと人のおなし心にさつもうつらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "44",
   "text": "すみそめの衣はうたしかくれかを浮世の人に知れもそする",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿五",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "45",
   "text": "等かゝる外山の松のむらしくれおなし木すゑをそめやわくらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿六",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "46",
   "text": "竜田姫いくしほそめて紅ゐのいろそふ山のもみちなるらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿六",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "47",
   "text": "あらし吹たかねの雲のあと晴て夕日のかけに時雨ふるなり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "48",
   "text": "はれくもりかけさたまらぬ冬の日の給ふもゑくれてくるゝ空かな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿七",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "49",
   "text": "霜ふかきおちはのうへやこほるらん庭に音せぬ木からしのかせ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "一廿八",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "50",
   "text": "かれまさるむくらのとほそ日にそへて中に霜やふかくとつらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "一廿八",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "51",
   "text": "附る夜はある井の水のあさこほり家よりさきにはや結ひけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿九",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "52",
   "text": "いかにせん花さく草はしもかれぬゑきみは盃にうつもれにけり",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "廿九",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "53",
   "text": "見なと江やあさみつゑほは磯こえて氷のうへによす而白浪",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "三十",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "54",
   "text": "をとたてゝいり江の浪はこほれとも尾花にのこるまのゝ浦風",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "三十",
   "side": "",
   "dai": "持"
  },
  {
   "seq": "55",
   "text": "わたつうみのおきつ小嶋もあらはれて浪まにみゆる盃のひとむら",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅一",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "56",
   "text": "うつもるゝ軒端の竹のすゑにしてけさみえそむる雪のまふやま",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅一",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "57",
   "text": "霜むすふうらはのあしの冬かれに残るは鴨のあをはなりけり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "58",
   "text": "水鳥のをりゐる波のうき枕むすひさためぬうす氷かな",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅二",
   "side": "",
   "dai": "持"
  },
  {
   "seq": "59",
   "text": "人しれすおもひいる野の初庵はをやかても袖の霞けかるらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅三",
   "side": "",
   "dai": ""
  },
  {
   "seq": "60",
   "text": "おもひたつこゝろひとつをしるへにてなれぬこひちにまよひ初ぬる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅三",
   "side": "右",
   "dai": ""
  },
  {
   "seq": "61",
   "text": "くちねたゝなみたの川のみをつくし深きしるしのみえもこそわれ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅四",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "62",
   "text": "もらすなよ苦にむもるゝ山の井の下にはせめてわきかへるとも",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅四",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "63",
   "text": "うききはもなをつくされぬみつくきのはては涙にうきくらしつゝ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "64",
   "text": "こひしなん後さへものやおもわまし此世にかきなむくひならすは",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅五",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "65",
   "text": "まちなるゝいふへのかねの声ことに今宵いかにときくそかなしき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅六",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "66",
   "text": "きかしたゝ待しはいつのゆふへともいまは忘るていりあひのかね",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅六",
   "side": "",
   "dai": "持"
  },
  {
   "seq": "67",
   "text": "あふまてと待にいのちの残る世を思ひはてはいかにすくさん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "左",
   "dai": ""
  },
  {
   "seq": "68",
   "text": "いたつらにこよひあけぬときゝなれてひとりぬるよも鳥の音そうき",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅七",
   "side": "右",
   "dai": "職"
  },
  {
   "seq": "69",
   "text": "いかにせんゑたひしほとのやすらひにあけはなれぬる横雲の空",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅八",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "70",
   "text": "袖のうへにあまるなみたやむすふらん我かへるさのみちしはの露",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅八",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "71",
   "text": "一夜とはせめてといひしことのはをまことに人のなすそかなしき",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅八",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "72",
   "text": "ともすれはうつゝになしてしたふかなみしよの夢の昔かたりを",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅八",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "73",
   "text": "おもひけるかすとは人のしれはこそうき身につらき色はみすらめ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅八",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "74",
   "text": "備りのあるまをうきになしてたにかはなちきりを猶やうらみん",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "卅八",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "75",
   "text": "身につもるよはひしられてあかつきのねさめになるとりの声かな",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十一",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "76",
   "text": "をのつからわすれしことも思ひ出て昔になるゝ暁のとこ",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十一",
   "side": "",
   "dai": "持"
  },
  {
   "seq": "77",
   "text": "ゆきくり有しみのさとは月影のいそゝもたとる竹のした道",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "78",
   "text": "くれ竹の枝たれおほひふる雨におふへのまとそくれまさり行",
   "kana": "",
   "speaker": "",
   "page": 12,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "79",
   "text": "うきしつむ世にくらふれはあすか川渕瀬の浪はかはらさりけり",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "80",
   "text": "山ふかみ苦のゑつくのたへ〳〵におちそふすゑや谷川の水",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十二",
   "side": "右",
   "dai": "勝"
  },
  {
   "seq": "81",
   "text": "いのりつるこゝろのすゑやとをからんせきの戸さゝぬ御代に成ぬる",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十四",
   "side": "左",
   "dai": "勝"
  },
  {
   "seq": "82",
   "text": "あつまちやけふあふさるの山着てすゑはかきりもしら川の関",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十四",
   "side": "",
   "dai": "勝"
  },
  {
   "seq": "83",
   "text": "行くれていなのにやとをかるもかくふゐのとこはあきかせそ吹",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十五",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "84",
   "text": "こよひともちきらぬ野辺の草枕なにとて露のむすひをきけん",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十五",
   "side": "",
   "dai": "持"
  },
  {
   "seq": "85",
   "text": "こえかへるやまちの月をまちわひてしはしおりしく峯の推楽",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十六",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "86",
   "text": "わけきつるあとにもかゝるゑらくものふかき山路はあふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 13,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十六",
   "side": "",
   "dai": "持"
  },
  {
   "seq": "87",
   "text": "世の中にすむかすならぬ身にしあれはさりとてとおもふあらさます",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "88",
   "text": "いつまわへもおもふはかりや世の中のうきになくさむ心ならん",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "右",
   "dai": "持"
  },
  {
   "seq": "89",
   "text": "石清水なかれをみてたてみなかみのにこらぬほともあらはれにける",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "左",
   "dai": "持"
  },
  {
   "seq": "90",
   "text": "一今さらにいのらすとてもおとこ山かみのすつつき御代己下",
   "kana": "",
   "speaker": "",
   "page": 14,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "四十七",
   "side": "右",
   "dai": "持"
  }
 ],
