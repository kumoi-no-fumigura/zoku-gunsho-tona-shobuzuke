   "dai": "持"
  },
  {
   "seq": "2",
   "text": "あしひきのやまちの雲のきえそむる跡や春くるしるへなるらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-729563",
   "form": "短歌",
   "genre": "",
   "ban": "一",
